# Copie para .env e preencha com os dados do SEU projeto Supabase.
# Use somente a chave pública (publishable/anon). Nunca coloque a service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# true = dados demonstrativos e seletor de perfil (somente para apresentação)
VITE_DEMO_MODE=false
